# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ADMIN_IDS=123456789,987654321

# Telegram Webhook Verification (recommended)
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Telegram Setup Route Auth (optional; for /api/telegram/setup-commands)
TELEGRAM_SETUP_SECRET=your-setup-secret

# OpenRouter AI (optional; enables natural-language editing)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-3-flash-preview

# GitHub (required for edits)
GITHUB_TOKEN=your-github-token-with-contents-write
GITHUB_OWNER=holditdowncic
GITHUB_REPO=hold
GITHUB_BRANCH=main

# Optional: used for "View Live Site" button
SITE_URL=https://www.holditdown.uk

# Stripe donations
NEXT_PUBLIC_STRIPE_DONATION_LINK_URL=https://buy.stripe.com/your-live-payment-link
STRIPE_SECRET_KEY=sk_live_or_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=gbp
STRIPE_DONATION_MIN_AMOUNT_GBP=5
STRIPE_DONATION_SUGGESTED_AMOUNTS_GBP=10,25,50,100

# Supabase voting backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenClaw vote notifications and secure results queries
OPENCLAW_BOT_TOKEN=your-openclaw-bot-token
OPENCLAW_CHAT_ID=your-openclaw-chat-id
OPENCLAW_WEBHOOK_URL=https://your-openclaw-webhook-endpoint
OPENCLAW_WEBHOOK_TOKEN=your-openclaw-webhook-token
VOTE_RESULTS_API_KEY=your-vote-results-api-key
